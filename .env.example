# Copy to .env and fill in values

# Must match ez-prep-api JWT_SECRET. Middleware verifies the admin session JWT.
JWT_SECRET=
PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# EzPrep NestJS backend
# Local: http://localhost:3000
# Production: https://ezprep-app.vercel.app
EZPREP_API_URL=http://localhost:3000
EZPREP_API_PREFIX=/api

# AWS credentials now live only on ez-prep-api. Do not expose them here.
