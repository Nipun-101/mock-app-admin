# Copy to .env and fill in values

MONGODB_URI=mongodb://localhost:27017/live
JWT_SECRET=
PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# EzPrep NestJS backend
# Local: http://localhost:3000
# Production: https://ezprep-app.vercel.app
EZPREP_API_URL=http://localhost:3000
EZPREP_API_PREFIX=/api

NEXT_PUBLIC_AWS_ACCESS_KEY_ID=xxx
NEXT_PUBLIC_AWS_SECRET_ACCESS_KEY=xxx
NEXT_PUBLIC_AWS_REGION=ap-south-1
NEXT_PUBLIC_AWS_S3_BUCKET=xxx
